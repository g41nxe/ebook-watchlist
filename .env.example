# Vorlage. Kopieren nach `.env` — die bleibt aus dem Repository draussen.

# Zeitzone des Containers. Die Anwendung rechnet in lokaler Zeit (ADR 12).
TZ=Europe/Berlin

# Optional. Gesetzt: das Bewertungstor urteilt ueber jeden Fund und haelt
# zurueck, was unter drei Sternen bleibt. Leer: alles erscheint unbewertet im
# Stapel — kein Fehler, nur kein Tor.
#
# Der zweite Weg des Tors — die lokal angemeldete `claude`-CLI — steht im
# Container nicht zur Verfuegung. Wer dort Urteile will, braucht diesen
# Schluessel.
ANTHROPIC_API_KEY=
